# Required
TELEGRAM_BOT_TOKEN=put_your_telegram_bot_token_here

# Required for Birdeye-powered Solana intelligence. The bot still runs without it,
# but Birdeye holder/security and wallet intelligence will remain UNKNOWN.
BIRDEYE_API_KEY=put_your_birdeye_api_key_here

# Optional: override Birdeye API base URL
# BIRDEYE_API_BASE_URL=https://public-api.birdeye.so
